# Standard OpenAI API key. Keep this file server-side and never commit .env.
OPENAI_API_KEY=

# Optional overrides.
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
REALTIME_REASONING_EFFORT=minimal

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765

# Activation runtime socket (native handler path)
# Usually inherited from the user session; fallback is /run/user/<uid>.
# XDG_RUNTIME_DIR=/run/user/1000
# Optional absolute override for tests and custom runtimes
# ACTIVATION_SOCKET_PATH=/tmp/okay-hermes-realtime/activation.sock
ACTIVATION_RESULT_TIMEOUT_SECONDS=3600

# Brave app-mode launcher settings for local voice UX.
BRAVE_BIN=/usr/bin/brave-origin-nightly
VOICE_BROWSER_PROFILE=~/.local/share/okay-hermes-realtime/brave-profile
VOICE_PAGE_URL=http://127.0.0.1:8765/voice
VOICE_BROWSER_START_TIMEOUT_SECONDS=20.0
KDE_TASK_NOTIFICATIONS=true

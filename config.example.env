# Replacement user service runtime defaults
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin
REALTIME_REASONING_EFFORT=minimal
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
BRAVE_BIN=/usr/bin/brave-origin-nightly
VOICE_BROWSER_PROFILE=~/.local/share/okay-hermes-realtime/brave-profile
VOICE_PAGE_URL=http://127.0.0.1:8765/voice
VOICE_BROWSER_START_TIMEOUT_SECONDS=10.0

# Wakeword listener tuning
WAKEWORD_MODEL_PATH=~/.local/share/okay-hermes-realtime/models/okay-hermes-realtime-wakeword.onnx
WAKEWORD_THRESHOLD=0.6973556280136108
WAKEWORD_CONSECUTIVE_WINDOWS=2
WAKEWORD_INFERENCE_INTERVAL_MS=250
WAKEWORD_CAPTURE_HEALTH_PATH=~/.local/state/okay-hermes-realtime/capture-health

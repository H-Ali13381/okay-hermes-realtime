# Replacement user service runtime defaults
OPENAI_API_KEY=
# Provider identity is fixed for the whole daemon session. Only openai is
# transport-active in this build; gemini is a registered contract-only provider.
VOICE_PROVIDER=openai
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
REALTIME_REASONING_EFFORT=minimal
# Registered but transport-inactive in this build.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
BRAVE_BIN=brave-origin
VOICE_BROWSER_PROFILE=~/.local/share/okay-hermes-realtime/brave-profile
VOICE_PAGE_URL=http://127.0.0.1:8765/voice
VOICE_BROWSER_START_TIMEOUT_SECONDS=20.0
KDE_TASK_NOTIFICATIONS=true

# Confirmed YouTube and anime playback
MPV_BIN=mpv
YT_DLP_BIN=yt-dlp
YOUTUBE_RESOLVE_TIMEOUT_SECONDS=12.0
# Optional yt-dlp browser-cookie source, for example: brave:Default
YOUTUBE_BROWSER_COOKIES=

# Wakeword listener tuning
WAKEWORD_MODEL_PATH=~/.local/share/okay-hermes-realtime/models/okay-hermes-realtime-wakeword.onnx
WAKEWORD_THRESHOLD=0.6973556280136108
WAKEWORD_CONSECUTIVE_WINDOWS=2
WAKEWORD_INFERENCE_INTERVAL_MS=250
WAKEWORD_CAPTURE_HEALTH_PATH=~/.local/state/okay-hermes-realtime/capture-health
